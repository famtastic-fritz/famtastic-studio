{
  "schema_version": 1,
  "data_root_env": "STUDIO_DATA_ROOT",
  "data_root_default": "../.studio-next-data",
  "source_root_default": "~/Development/FAMtastic/sites",
  "roots": {
    "sites": "sites",
    "apps": "apps",
    "previews": "previews",
    "media": "media",
    "components": "components",
    "dna": ".studio/dna",
    "recipes": ".studio/recipes",
    "packets": ".studio/packets",
    "journal": ".studio/journal",
    "conversations": ".studio/conversations",
    "events": ".studio/events",
    "execution": ".studio/execution",
    "famtasticinc": ".studio/famtasticinc",
    "deploys": ".studio/deploys",
    "learning": ".studio/learning"
  },
  "preview": {
    "port": 3400,
    "bind_lan": false
  },
  "portfolio_roots": {
    "sites": "~/Development/FAMtastic/sites",
    "apps": "~/Development/FAMtastic/Apps"
