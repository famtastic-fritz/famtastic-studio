{
  "schema_version": 1,
  "enabled": true,
  "provider": "pollinations",
  "endpoint": "https://image.pollinations.ai/prompt",
  "width": 1024,
  "height": 576,
  "max_images_per_run": 12,
  "concurrency": 2,
  "timeout_ms": 60000,
