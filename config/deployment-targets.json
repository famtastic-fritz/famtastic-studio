{
  "schema_version": 1,
  "default_target": "famtasticinc-shared",
  "targets": {
    "famtasticinc-shared": {
      "provider": "famtasticinc",
      "hosting_class": "shared",
      "transport": "sftp",
      "proof_root": "/home/nineoo/public_html/famtasticinc-landing",
      "repo_mode": "create_or_existing",
      "dns_mode": "owner_authorized_after_payment",
      "notes": "Default Web Basics delivery path. No Netlify fallback."
    },
    "famtasticinc-vps": {
      "provider": "famtasticinc",
      "hosting_class": "vps",
      "transport": "ssh_or_sftp",
      "proof_root": null,
      "repo_mode": "existing_or_bootstrap",
      "dns_mode": "owner_authorized_after_payment",
      "notes": "Higher-bandwidth path; the remote root and transport are selected per contract."
    },
    "existing-client-repo": {
      "provider": "famtasticinc",
      "hosting_class": "managed_external",
      "transport": "injected",
      "proof_root": null,
      "repo_mode": "existing",
      "dns_mode": "owner_authorized_after_payment",
      "notes": "Requires an explicit repository URL, branch, deployment target, and receipt callback."
    },
    "local": {
      "provider": "local",
      "hosting_class": "local",
      "transport": "filesystem",
      "proof_root": null,
      "repo_mode": "fixture",
      "dns_mode": "never",
      "notes": "Offline proof and parity only."
    }
  }
}
