# Copy to an untracked file outside the repository, then replace every example.
PHASE2_PROJECT_ID=example-project
PHASE2_REGION=us-central1
PHASE2_CONTROL_SERVICE=studio-phase2-control
PHASE2_WORKER_SERVICE=studio-phase2-worker
PHASE2_QUEUE=studio-phase2-shadow
PHASE2_SCHEDULER_JOB=studio-phase2-dispatch
PHASE2_PILOT_RUN_ID=pilot-run-001
# Valid range is 80000 through 250000; 250000 funds three bounded attempts.
PHASE2_MAX_JOB_COST_MICROS=250000
PHASE2_MAX_TOTAL_COST_MICROS=5000000
PHASE2_MODEL=gemini-3.1-flash-lite
PHASE2_PRICEBOOK_VERSION=vertex-gemini-2026-09-21
PHASE2_VERTEX_LOCATION=global
PHASE2_FIRESTORE_DATABASE=studio-phase2-shadow
PHASE2_SOURCE_BUCKET=example-project-studio-phase2-source
PHASE2_ARTIFACT_BUCKET=example-project-studio-phase2-artifacts
PHASE2_WORKER_URL=https://studio-phase2-worker-123456789012.us-central1.run.app/internal/tasks/execute
PHASE2_WORKER_AUDIENCE=https://studio-phase2-worker-123456789012.us-central1.run.app
PHASE2_CONTROL_AUDIENCE=https://studio-phase2-control-123456789012.us-central1.run.app

# Images must be immutable Artifact Registry digest references. Tags are rejected.
PHASE2_CONTROL_IMAGE=us-central1-docker.pkg.dev/example-project/studio-phase2/control@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
PHASE2_WORKER_IMAGE=us-central1-docker.pkg.dev/example-project/studio-phase2/worker@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
PHASE2_ARTIFACT_REPOSITORY=studio-phase2

PHASE2_CONTROL_SA=studio-p2-control
PHASE2_WORKER_SA=studio-p2-worker
PHASE2_INTAKE_SA=studio-p2-intake
PHASE2_SCHEDULER_SA=studio-p2-scheduler
PHASE2_TASK_INVOKER_SA=studio-p2-task-invoker

# Build-only input. Supply a trusted Node 24 base by immutable digest.
PHASE2_NODE_BASE_IMAGE=node:24-bookworm-slim@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc

# Optional. Budget alerts notify; they do not stop spend.
PHASE2_BILLING_ACCOUNT=000000-000000-000000
PHASE2_BUDGET_AMOUNT_USD=25
